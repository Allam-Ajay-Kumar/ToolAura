# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Replace with your actual MongoDB Atlas connection string in Phase 4
MONGO_URI=mongodb://localhost:27017/ai_tools_directory

# JWT Configuration
# This is a secret key used to sign and verify tokens
# Use a long, random string — never share this publicly
JWT_SECRET=your_super_secret_jwt_key_replace_this_in_production
JWT_EXPIRE=30d

